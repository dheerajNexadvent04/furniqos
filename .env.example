# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000

# Supabase (optional - leads are saved locally if not configured)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only secret (Project Settings > API). Lets the server read leads while RLS keeps them private.
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=

# Figma personal access token (only needed for the scripts/ design import tools)
FIGMA_TOKEN=
